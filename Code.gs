const SHEET_ID="PASTE_YOUR_EXISTING_SHEET_ID_HERE",EXP="Expenses",BUD="Budgets";function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}function doGet(e){try{let m=e.parameter.month,ss=SpreadsheetApp.openById(SHEET_ID),b=bud(ss,m),x=ex(ss,m);return out({ok:true,settings:{income:b.i,overallBudget:b.o},budgets:b.b,expenses:x})}catch(e){return out({ok:false,error:String(e)})}}function doPost(e){try{let p=e.parameter||{},ss=SpreadsheetApp.openById(SHEET_ID);if(p.action=="saveBudget"){let s=ss.getSheetByName(BUD)||ss.insertSheet(BUD);if(s.getLastRow()==0)s.appendRow(["Month","Income","OverallBudget","Category","CategoryBudget","UpdatedAt"]);let d=s.getDataRange().getValues();for(let i=d.length-1;i>=1;i--)if(String(d[i][0])==p.month)s.deleteRow(i+1);let b=JSON.parse(p.budgets||"{}");Object.keys(b).forEach(c=>s.appendRow([p.month,+p.income||0,+p.overallBudget||0,c,+b[c]||0,new Date()]));return out({ok:true})}let n=+p.amount;if(!(n>0))throw Error("Invalid amount");let s=ss.getSheetByName(EXP)||ss.insertSheet(EXP);if(s.getLastRow()==0)s.appendRow(["Date","Time","Amount","Mode","Category","Description","Timestamp"]);s.appendRow([p.date,new Date(),n,p.mode||"",p.category||"",p.description||"",+p.ts||Date.now()]);return out({ok:true})}catch(e){return out({ok:false,error:String(e)})}}function bud(ss,m){let s=ss.getSheetByName(BUD),r={i:0,o:0,b:{}};if(!s||s.getLastRow()<2)return r;let d=s.getDataRange().getValues();d.slice(1).forEach(x=>{if(String(x[0])==m){r.i=+x[1]||0;r.o=+x[2]||0;if(x[3])r.b[String(x[3])]=+x[4]||0}});return r}function ex(ss,m){let s=ss.getSheetByName(EXP),r=[];if(!s||s.getLastRow()<2)return r;s.getDataRange().getValues().slice(1).forEach(x=>{let d=x[0] instanceof Date?Utilities.formatDate(x[0],Session.getScriptTimeZone(),"yyyy-MM-dd"):String(x[0]);if(d.slice(0,7)==m)r.push({date:d,ts:+x[6]||Date.now(),amount:+x[2]||0,mode:String(x[3]||""),category:String(x[4]||""),description:String(x[5]||"")})});return r}